{
  "name": "@antigravity-bridge/cli",
  "version": "2.0.0",
  "description": "Command-line interface (agb) for Antigravity Chrome Bridge",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agb": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check src"
  },
  "dependencies": {
    "@antigravity-bridge/protocol": "workspace:*",
    "@antigravity-bridge/sdk": "workspace:*"
  },
  "devDependencies": {
    "@antigravity-bridge/server": "workspace:*",
    "@types/node": "^22.15.17",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "ws": "^8.18.2"
  }
}
