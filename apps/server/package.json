{
  "name": "@antigravity-bridge/server",
  "version": "2.0.0",
  "description": "HTTP + WebSocket bridge server for Antigravity Chrome Bridge",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check src"
  },
  "dependencies": {
    "@antigravity-bridge/protocol": "workspace:*",
    "@hono/node-server": "^1.14.2",
    "hono": "^4.7.10",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
