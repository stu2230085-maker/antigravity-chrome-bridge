{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@antigravity-bridge/server#build": {
      "dependsOn": ["^build", "@antigravity-bridge/dashboard#build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build", "@antigravity-bridge/dashboard#build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    }
  }
}
